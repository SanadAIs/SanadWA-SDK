{
    "name": "sanadwa/whatsapp-sdk-php",
    "description": "Official PHP and Laravel SDK for the SANAD WhatsApp Public API",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7",
        "guzzlehttp/psr7": "^2",
        "psr/http-client": "^1",
        "psr/http-message": "^1|^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "illuminate/container": "^10|^11|^12",
        "illuminate/config": "^10|^11|^12",
        "illuminate/support": "^10|^11|^12"
    },
    "suggest": {
        "illuminate/support": "Required for Laravel service provider and facade integration",
        "illuminate/http": "Only needed when following the README webhook controller example"
    },
    "autoload": {
        "psr-4": {
            "Sanadwa\\WhatsApp\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sanadwa\\WhatsApp\\Tests\\": "php/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sanadwa\\WhatsApp\\Laravel\\SanadWhatsAppServiceProvider"
            ],
            "aliases": {
                "SanadWhatsApp": "Sanadwa\\WhatsApp\\Laravel\\Facades\\SanadWhatsApp"
            }
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php php/tests"
    },
    "minimum-stability": "stable"
}
